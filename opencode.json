{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@mohak34/opencode-notifier@latest",
    "opencode-snip@latest",
    "@tarquinen/opencode-dcp@latest",
    "opencode-froggy",
    "opencode-antigravity-multi-auth@latest",
    "@spoons-and-mirrors/pocket-universe@latest",
    "opencode-mystatus",
    "opencode-gemini-auth@latest",
    "opencode-claude-auth@latest",
    "opencode-openai-codex-auth"
  ],
  "default_agent": "orchestrator",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${EXA_API_KEY}"
      }
    },
    "figma-mcp-desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "touch *": "ask",
      "mkdir *": "ask",
      "rm *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "dd *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "npm install *": "ask",
      "pip install *": "ask",
      "git push": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "reboot": "ask",
      "shutdown": "ask",
      "kill *": "ask",
      "killall *": "ask",
      "docker *": "ask",
      "mkfs *": "ask",
      "fdisk *": "ask",
      "parted *": "ask",
      "format *": "ask",
      "git branch -d *": "ask",
      "git branch -D *": "ask",
      "git rebase *": "ask",
      "npm run publish": "ask",
      "brew install *": "ask",
      "brew upgrade *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "psql * -c *DROP*": "ask",
      "psql * -c *TRUNCATE*": "ask"
    },
    "task": {
      "*": "allow"
    },
    "question": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "saveCommitMessage": {
      "*": "allow"
    },
    "getSessionID": {
      "*": "allow"
    },
    "getCommitMessage": {
      "*": "allow"
    },
    "question": "allow",
    "websearch": "deny",
    "webfetch": "deny",
    "mcp-context7*": "deny",
    "mcp-exa*": "deny",
    "mcp-figma-mcp-desktop*": "deny",
    "mcp-playwright*": "deny",
    "mcp-github*": "deny",
    "doom_loop": "ask",
    "external_directory": "ask"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "glm-5.1:cloud": {
          "name": "glm-5.1:cloud"
        },
        "glm-5:cloud": {
          "name": "glm-5:cloud"
        },
        "glm-4.7:cloud": {
          "name": "glm-4.7:cloud"
        },
        "gemma4:31b-cloud": {
          "name": "gemma4:31b-cloud"
        },
        "kimi-k2.6:cloud": {
          "name": "kimi-k2.6:cloud"
        }
      }
    },
    "openai": {
      "options": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    }
  },
  "agents": {
    "deep-thinker": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "xhigh" }
    },
    "whiteboarding": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "high" }
    },
    "requirements-analyzer": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "high" }
    },
    "code-reviewer": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "high" }
    },
    "reviewing": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "medium" }
    },
    "refactoring": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "medium" }
    },
    "code-simplifier": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "medium" }
    },
    "web-researcher": {
      "model": "gpt-5.5",
      "provider": "openai",
      "options": { "reasoningEffort": "low" }
    },
    "building": {
      "model": "kimi-k2.6:cloud",
      "provider": "ollama"
    },
    "effort-estimator": {
      "model": "kimi-k2.6:cloud",
      "provider": "ollama"
    }
  },
  "command": {
    "mystatus": {
      "description": "Query quota usage for all AI accounts",
      "template": "Use the mystatus tool to query quota usage. Return the result as-is without modification."
    }
  }
}
